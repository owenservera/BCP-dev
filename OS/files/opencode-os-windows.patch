+/// Keep background CLI processes from flashing a console window. The release
+/// build of the app uses the Windows GUI subsystem, so every child console
+/// program would otherwise pop up its own window. No-op on other platforms.
+pub fn hide_console(cmd: &mut Command) -> &mut Command {
+    #[cfg(windows)]
+    {
+        use std::os::windows::process::CommandExt;
+        cmd.creation_flags(0x0800_0000); // CREATE_NO_WINDOW
+    }
+    cmd
+}
+
+/// The program name to launch for the OpenCode CLI. On Windows the native
+/// installer provides `opencode.exe`, but an npm install provides an
+/// `opencode.cmd` shim, which `Command::new("opencode")` cannot find without
+/// the extension — so fall back to it. Unchanged on other platforms.
+pub fn resolve_bin(bin: &str) -> String {
+    #[cfg(windows)]
+    {
+        let mut probe = Command::new(bin);
+        probe
+            .arg("--version")
+            .stdin(Stdio::null())
+            .stdout(Stdio::null())
+            .stderr(Stdio::null());
+        hide_console(&mut probe);
+        if probe.status().is_err() {
+            return format!("{bin}.cmd");
+        }
+    }
+    bin.to_string()
+}
+
+/// Windows: pick up PATH changes made by an installer (which updates the
+/// user/machine PATH in the registry, not this process). No-op elsewhere.
+pub fn refresh_path() {
+    #[cfg(windows)]
+    {
+        let mut cmd = Command::new("powershell");
+        cmd.args([
+            "-NoProfile",
+            "-Command",
+            "[Environment]::GetEnvironmentVariable('Path','User') + ';' + [Environment]::GetEnvironmentVariable('Path','Machine')",
+        ]);
+        hide_console(&mut cmd);
+        if let Ok(out) = cmd.output() {
+            let fresh = String::from_utf8_lossy(&out.stdout).trim().to_string();
+            if !fresh.is_empty() {
+                let current = std::env::var("PATH").unwrap_or_default();
+                std::env::set_var("PATH", format!("{fresh};{current}"));
+            }
+        }
+    }
+}
+
