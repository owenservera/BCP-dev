{
  "$schema": "https://opencode.ai/config.json",

  // Ω Resident Team Lab — experimental resident-team configuration.
  // This file is intentionally isolated: it is NOT the global opencode config.
  // Activate it with:  OPENCODE_CONFIG=<this file> opencode ...
  //
  // Linux sandbox adaptation of the reference lab in
  // owenservera/BCP-dev@work/omega-endstate/STEW-01/bootstrap-team.
  // All models below are OpenCode Zen FREE models (keyless anonymous tier).

  // Default model used by any agent without an explicit override.
  "model": "opencode/big-pickle",

  "default_agent": "team-root",

  // VIVIM observation layer: on this build (1.18.33) the config `plugin`
  // array resolves entries as npm package specifiers; loose .ts paths were
  // observed NOT to load (see docs/PROOF-LOG.md). The harness therefore
  // deploys plugin/resident-team.ts (byte-identical copy) to
  // <project>/.opencode/plugin/resident-team-lab.ts, the documented
  // auto-discovery location.

  // Native Task depth: root -> resident -> worker.
  // Schema default is 1 (subagents may not spawn subagents); 2 is required
  // for the resident -> worker hop to exist at all.
  "subagent_depth": 2,

  // Global ceiling for the experiment. Agent-specific rules below narrow this.
  // NOTE (empirical, 2026-09-28): permission.task patterns are PREFIX globs on
  // this build: "research-resident" does not match "resident-*". The concrete
  // registered names are therefore listed explicitly beside the families.
  "permission": {
    "task": {
      "*": "deny",
      "resident-*": "allow",
      "research-resident": "allow"
    }
  },

  "agent": {
    "team-root": {
      "description": "Experimental Ω team root. Coordinates at owner/workstream level and may create registered residents.",
      "mode": "primary",
      "model": "opencode/space-bunny-free",
      "prompt": "{file:./prompts/team-root.md}",
      "permission": {
        "task": {
          "*": "deny",
          "resident-*": "allow",
          "research-resident": "allow"
        }
      }
    },

    "research-resident": {
      "description": "Experimental durable-shaped resident for research work. Forms its own judgment and may recruit bounded research workers.",
      "mode": "subagent",
      "model": "opencode/nemotron-3.5-lightning-free",
      "prompt": "{file:./prompts/research-resident.md}",
      "permission": {
        "task": {
          "*": "deny",
          "worker-*": "allow",
          "research-worker": "allow"
        }
      }
    },

    "research-worker": {
      "description": "Experimental leaf worker. Performs bounded research only and cannot recruit other agents.",
      "mode": "subagent",
      "model": "opencode/mimo-v2.6-flash-free",
      "prompt": "{file:./prompts/research-worker.md}",
      "permission": {
        "task": "deny",
        "edit": "deny",
        "write": "deny"
      }
    }
  }
}
