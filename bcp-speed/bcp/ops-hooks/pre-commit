#!/bin/sh
# BCP-SPEED pre-commit hook (installed by ops-install.ps1, source: ops-hooks/pre-commit).
# Refuses commits while validate.py reports errors. Skips gracefully when
# python is unavailable in this environment (never blocks unrelated work).
if ! command -v python >/dev/null 2>&1; then
  echo "pre-commit: python not found, validate gate skipped" >&2
  exit 0
fi
if ! python validate.py >/dev/null 2>&1; then
  echo "pre-commit: REFUSED — validate.py reports errors. Run python validate.py, fix state, retry." >&2
  exit 1
fi
exit 0
