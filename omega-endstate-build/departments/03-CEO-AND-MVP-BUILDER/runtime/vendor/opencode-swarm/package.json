{
  "name": "@ibraheem-111/opencode-swarm",
  "version": "0.2.2",
  "description": "Multi-agent swarms for opencode: parallel agents with shared memory, persistent state, inter-agent messaging, and completion notifications. No fork required.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "swarm": "src/cli.ts"
  },
  "exports": {
    ".": "./src/index.ts",
    "./plugin/swarm": "./plugin/swarm.ts",
    "./plugin/notify": "./plugin/notify.ts"
  },
  "scripts": {
    "test": "bun test tests/",
    "typecheck": "tsc --noEmit",
    "smoke": "bun scripts/smoke.ts",
    "build:release": "bash scripts/build-release.sh"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ibraheem-111/opencode-swarm.git"
  },
  "keywords": [
    "opencode",
    "agents",
    "swarm",
    "multi-agent",
    "openrouter",
    "llm",
    "mcp"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@opencode-ai/plugin": "^1.16.2",
    "@opencode-ai/sdk": "^1.16.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "typescript": "^5.9.0"
  },
  "files": [
    "src",
    "plugin",
    "examples",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  }
}
